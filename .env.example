# Where enquiry form submissions are delivered (POST, JSON). For example a CRM webhook,
# an automation platform (Make, n8n, Zapier) or an email relay. Required in production:
# without it the form returns "temporarily unavailable" rather than silently dropping enquiries.
ENQUIRY_WEBHOOK_URL=
# Optional bearer token sent as "Authorization: Bearer <secret>" to the webhook.
ENQUIRY_WEBHOOK_SECRET=
